# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable key (both safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of this app, without a trailing slash.
# Used to build links in emails and invitations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
