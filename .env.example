# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable key (both safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of this app, without a trailing slash.
# Used to build links in emails and invitations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the public request page (safe for the browser).
# For local testing use Cloudflare's always-pass test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- Server-only secrets: never prefix with NEXT_PUBLIC_, never commit ----

# Supabase secret key (Dashboard → Project Settings → API Keys → Secret keys).
# Bypasses Row Level Security; used only by server code: the public request page
# and the AI analysis (claiming a request and saving the result).
SUPABASE_SECRET_KEY=

# Random string of at least 16 characters, used to hash visitors' IP addresses
# for rate limiting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTAKE_HASH_SECRET=

# Cloudflare Turnstile secret key. For local testing use the always-pass test
# secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ---- AI suggestions (optional; server-only) ----
# Anthropic API key from console.anthropic.com. Without it the app works as
# before and the request page says AI suggestions are not set up.
# Only the description, kind of help, quantity and area are sent; names,
# phone numbers and emails are removed first.
ANTHROPIC_API_KEY=
# Model used for analysis. Default: claude-haiku-5-5 (claude-sonnet-5-5 also works).
AI_MODEL=claude-haiku-5-5
# Most AI analyses allowed in any 24 hours across the platform (protects prepaid
# credit). Requests over the limit wait and can be analysed the next day.
AI_DAILY_LIMIT=300
